---
import "../styles/global.css";
import { DESCRIPTION, EMAIL, FORM_URL, INDEXABLE, MAIN_SITE_URL, NAME, PERSON_ID, SAME_AS, SITE_URL, TITLE, WHATSAPP_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  // Extra JSON-LD nodes for this page, added next to the shared Person and WebSite nodes.
  schema?: object[];
  noindex?: boolean;
  // The page starts with a full-bleed hero under the header: the header is see-through at the very top.
  overlay?: boolean;
}

const { title = TITLE, description = DESCRIPTION, schema = [], noindex = false, overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const robots = INDEXABLE && !noindex ? "index, follow" : "noindex, nofollow";

// Lucide icon bodies (24x24, stroke), inlined like the theme icons.
const ICONS: Record<string, string> = {
  Email: '<rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />',
  LinkedIn: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" />',
  GitHub: '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" />',
  "Main site": '<circle cx="12" cy="12" r="10" /><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20" /><path d="M2 12h20" />',
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      url: `${SITE_URL}/`,
      name: `${NAME} | Video Editor`,
      inLanguage: "en",
      publisher: { "@id": PERSON_ID },
    },
    {
      "@type": "Person",
      "@id": PERSON_ID,
      name: NAME,
      alternateName: ["Darwin Iquina", "darcoded"],
      url: `${MAIN_SITE_URL}/`,
      email: EMAIL,
      sameAs: [...SAME_AS, `${SITE_URL}/`],
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/darcoded.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/darcoded-32.png" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    {/* Videos play from Drive, so open that connection early. */}
    <link rel="preconnect" href="https://drive.google.com" />
    <meta name="color-scheme" content="dark light" />
    <script is:inline>
      // Runs before paint so the page never flashes the wrong theme. Saved choice wins, else the system setting.
      (() => {
        let theme;
        try { theme = localStorage.getItem("theme"); } catch {}
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(graph).replaceAll("<", "\\u003c")} />
  </head>
  <body class="min-h-screen">
    <header id="site-header" data-overlay={overlay || undefined} data-top={overlay || undefined} class="sticky top-0 z-50 flex items-center justify-between h-16 bg-bg px-5 font-mono text-sm font-bold uppercase tracking-tight md:text-xl transition-[transform,background-color] duration-300 data-[hidden]:-translate-y-full motion-reduce:transition-none">
      <a href="/" class="flex items-center gap-2 text-fg md:gap-3">
        <img src="/darcoded-monogram-white.svg" alt="" width="28" height="28" class="show-dark h-6 w-6 md:h-8 md:w-8" />
        <img src="/darcoded-monogram-color.svg" alt="" width="28" height="28" class="show-light h-6 w-6 md:h-8 md:w-8" />
        {NAME}
      </a>
      <nav class="flex items-center gap-4 text-muted md:gap-8">
        <a href="/#filters" class="hover:text-fg">Work</a>
        <a href={MAIN_SITE_URL} class="hover:text-fg">About</a>
        {/* Same Sun and Moon icons (lucide, stroke 1.8) as the main portfolio, inlined so no icon library ships. */}
        <button id="theme-toggle" type="button" aria-label="Switch theme" class="hover:text-fg focus-visible:outline focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-accent">
          <svg class="show-dark h-5 w-5 md:h-7 md:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2" /><path d="M12 20v2" /><path d="m4.93 4.93 1.41 1.41" /><path d="m17.66 17.66 1.41 1.41" />
            <path d="M2 12h2" /><path d="M20 12h2" /><path d="m6.34 17.66-1.41 1.41" /><path d="m19.07 4.93-1.41 1.41" />
          </svg>
          <svg class="show-light h-5 w-5 md:h-7 md:w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
          </svg>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    {/* Floating chat button. On desktop it sits left of the ruler strip so the two never overlap. */}
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" aria-label="Chat on WhatsApp +63 945 260 7161" draggable="false" class="group fixed bottom-5 right-4 z-50 flex h-14 items-center rounded-full px-3.5 bg-[#25d366] text-white shadow-lg transition-transform hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 md:right-16">
      <svg class="h-7 w-7 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" /></svg>
      {/* Icon only until hovered, then the number slides out. Real text in the link: click opens WhatsApp, drag selects it for copying (draggable="false" stops the link-drag that blocks selection). */}
      <span class="max-w-0 select-text overflow-hidden whitespace-nowrap font-bold tracking-tight opacity-0 transition-all duration-300 ease-[cubic-bezier(0.34,1.4,0.64,1)] group-hover:ml-3 group-hover:mr-1 group-hover:max-w-56 group-hover:opacity-100 group-focus-visible:ml-3 group-focus-visible:mr-1 group-focus-visible:max-w-56 group-focus-visible:opacity-100 motion-reduce:transition-none">+63 945 260 7161</span>
    </a>
    <footer id="contact" class="mt-24 px-5 pb-6 md:pr-14">
      <div class="grid gap-10 border-y-2 border-fg py-10 md:grid-cols-[1.15fr_0.85fr] md:gap-16 md:py-14">
        <div>
          <h2 class="text-balance text-3xl font-bold leading-tight md:text-5xl">
            Have a <span class="bg-[#7c6fe0] px-2 text-white [box-decoration-break:clone]">video</span> in mind?
          </h2>
          <p class="mt-5 max-w-xl text-muted">Send me the idea, the platform and any footage you have. A rough brief is enough to start.</p>
          <a href={FORM_URL} target="_blank" rel="noopener noreferrer" class="group mt-8 inline-flex items-center gap-2 rounded-md bg-fg px-5 py-3 font-bold text-bg hover:opacity-90">
            Let's work together
            {/* Lucide arrow-up-right: the form opens in a new tab. */}
            <svg class="h-5 w-5 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 7h10v10" /><path d="M7 17 17 7" /></svg>
          </a>
        </div>
        <ul aria-label="Contact links" class="self-center">
          {
            [
              ["Email", `mailto:${EMAIL}`, EMAIL, "Email Darwin"],
              ["LinkedIn", SAME_AS[2], "", "Open LinkedIn"],
              ["GitHub", SAME_AS[1], "", "Open GitHub"],
              ["Main site", `${MAIN_SITE_URL}/`, MAIN_SITE_URL.replace("https://", ""), "Visit main site"],
            ].map(([label, href, shown, cta]) => (
              <li class="flex items-center justify-between gap-4 border-b border-line first:border-t">
                <a href={href} class="flex items-center gap-3 py-4 font-bold hover:text-accent">
                  <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[label]} />
                  {cta}
                </a>
                {/* Plain text, not inside the link, so it can be selected (one click selects all) and copied. */}
                {shown && <span class="select-all break-all text-right text-sm text-muted">{shown}</span>}
              </li>
            ))
          }
        </ul>
      </div>
      <p class="mt-6 flex flex-wrap justify-between gap-2 text-sm text-muted">
        <span>© {new Date().getFullYear()} {NAME}</span>
        <span>Video editing · UGC</span>
      </p>
    </footer>
    <script>
      // Header hides while scrolling down and returns on any scroll up (or near the top).
      const header = document.getElementById("site-header")!;
      let lastY = scrollY;
      addEventListener(
        "scroll",
        () => {
          const goingDown = scrollY > lastY && scrollY > header.offsetHeight;
          header.toggleAttribute("data-hidden", goingDown);
          if (header.hasAttribute("data-overlay")) header.toggleAttribute("data-top", scrollY < 8); // solid again once the page moves
          lastY = scrollY;
        },
        { passive: true },
      );
    </script>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");

      // The icon shows the current theme's opposite, so the label names the theme a click switches to.
      function syncLabel() {
        const label = `Switch to ${root.dataset.theme === "light" ? "dark" : "light"} mode`;
        toggle?.setAttribute("aria-label", label);
        toggle?.setAttribute("title", label);
      }

      syncLabel();
      toggle?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        syncLabel();
      });
    </script>
  </body>
</html>
