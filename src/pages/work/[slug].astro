---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import { parseVideo } from "../../lib/video";
import { NAME, PERSON_ID, SITE_URL } from "../../lib/site";

export const getStaticPaths = (async () => {
  const work = await getCollection("work");
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const video = data.videoUrl ? parseVideo(data.videoUrl) : undefined;
const thumbnail = video?.thumbnail;

const name = [data.client, data.title].filter(Boolean).join(" ");
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const schema = [
  {
    "@type": "WebPage",
    "@id": pageUrl,
    url: pageUrl,
    name,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    mainEntity: { "@id": `${pageUrl}#video` },
  },
  // Google requires thumbnail and upload date for VideoObject, so only emit it when both are real.
  ...(video && thumbnail && data.published
    ? [
        {
          "@type": "VideoObject",
          "@id": `${pageUrl}#video`,
          name,
          description: data.description ?? name,
          thumbnailUrl: thumbnail,
          uploadDate: data.published,
          embedUrl: video.embed,
          creator: { "@id": PERSON_ID },
        },
      ]
    : []),
];
---

<Base title={`${name} | ${NAME}`} description={data.description} schema={schema}>
  {/* Reels are vertical: the player is 9:16 and capped by screen height, with the details beside it on desktop. */}
  <article class="grid gap-8 px-5 md:grid-cols-[auto_1fr] md:items-start md:gap-12">
    <div class="mx-auto aspect-[9/16] w-full max-w-[calc(80vh*9/16)] overflow-hidden rounded-sm bg-surface md:mx-0 md:w-[calc(80vh*9/16)]">
      {video ? (
        <iframe src={video.embed} title={name} loading="lazy" allowfullscreen class="h-full w-full"></iframe>
      ) : (
        // shortcut: no full video linked yet, so the 2.5 s preview loops here. Add videoUrl to replace it.
        <video src={`/previews/${entry.id}.mp4`} poster={`/previews/${entry.id}.webp`} autoplay muted loop playsinline class="h-full w-full object-cover"></video>
      )}
    </div>
    <div class="md:pt-2">
      {data.client && <p class="text-sm text-accent">{data.client}</p>}
      <h1 class="text-3xl font-bold md:text-4xl">{data.title}</h1>
      {(data.role || data.year) && <p class="mt-2 text-muted">{[data.role, data.year].filter(Boolean).join(" · ")}</p>}
      {data.description && <p class="mt-4 max-w-prose">{data.description}</p>}
      <div class="mt-4 max-w-prose"><Content /></div>
      <a href="/#work" class="mt-10 inline-block text-muted hover:text-fg">← All work</a>
    </div>
  </article>
</Base>
