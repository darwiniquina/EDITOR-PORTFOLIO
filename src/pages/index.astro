---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { parseVideo } from "../lib/video";
import { CATEGORIES, CTA_HREF, CTA_TEXT, HOOK_1, HOOK_2, REEL, REEL_POSTER } from "../lib/site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
// Only offer a chip for categories that have at least one project.
const chips = Object.entries(CATEGORIES).filter(([key]) => work.some((w) => w.data.category === key));
---

<Base>
  {/* The poster is a real img so it also shows when the video is hidden (reduced motion) or still loading. */}
  <section class="relative aspect-[8/3] min-h-[420px] w-full overflow-hidden bg-neutral-900">
    <img src={REEL_POSTER} alt="" width="1920" height="720" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
    {REEL && <video src={REEL} poster={REEL_POSTER} autoplay muted loop playsinline preload="metadata" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover"></video>}
    {/* Dark layer keeps the footage from competing with the text. Heavier at the bottom where the text sits. */}
    <div class="absolute inset-0 bg-black/78 backdrop-blur-[2px] bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center px-5 text-center text-white">
      <h1 class="max-w-3xl text-balance text-[1.75rem] font-bold leading-tight md:text-[3.4rem]">
        <span class="block">
          {HOOK_1.before}{" "}<span class="bg-[#7c6fe0] px-2 [box-decoration-break:clone]">{HOOK_1.mark}</span>{HOOK_1.after}
        </span>
        <span class="mt-3 block md:mt-4">
          {HOOK_2.before}{" "}
          {/* Selection-box look: corner handles and a cursor. Decorative parts are aria-hidden. */}
          <span class="relative mx-1 inline-block bg-[#7c6fe0] px-2 md:px-3">
            {HOOK_2.mark}
            <span aria-hidden="true" class="absolute -left-2 -top-2 h-3.5 w-3.5 rounded-full border-2 border-white bg-[#3b5bdb] md:h-4 md:w-4"></span>
            <span aria-hidden="true" class="absolute -bottom-2 -right-2 h-3.5 w-3.5 rounded-full border-2 border-white bg-[#3b5bdb] md:h-4 md:w-4"></span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="absolute -bottom-7 -right-6 h-7 w-7 drop-shadow md:-bottom-9 md:-right-8 md:h-9 md:w-9">
              <path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>{" "}
          {HOOK_2.after}
        </span>
      </h1>
      <a href={CTA_HREF} class="group mt-10 inline-flex items-center gap-2 rounded-md bg-white px-5 py-3 font-bold text-black hover:bg-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        {CTA_TEXT}
        {/* Lucide arrow-right, inlined like the theme icons. */}
        <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  {/* Vertical reels: 9:16 cards. Clips loop on their own; hovering a card darkens it with a play button. Clicking opens the video in a modal; the link still works as a normal page link (new tab, no JS). */}
  {/* Big type selector. A purple block (same colour as the hero highlight) slides under the active option. */}
  <div class="mt-12 px-5 md:pr-14">
    <div id="filters" role="group" aria-label="Filter by type" class="group relative flex flex-wrap items-center gap-x-1 gap-y-1 border-y-2 border-fg py-4">
      <span id="filter-pill" aria-hidden="true" class="absolute left-0 top-0 h-0 w-0 bg-[#7c6fe0] transition-[left,top,width,height] duration-300 ease-out motion-reduce:transition-none">
        <span class="absolute -left-1.5 -top-1.5 h-3 w-3 rounded-full border-2 border-white bg-[#3b5bdb]"></span>
        <span class="absolute -bottom-1.5 -right-1.5 h-3 w-3 rounded-full border-2 border-white bg-[#3b5bdb]"></span>
      </span>
      {
        [["all", "All", work.length], ...chips.map(([key, label]) => [key, label, work.filter((w) => w.data.category === key).length])].map(([key, label, count], i) => (
          <Fragment>
            {i > 0 && <span aria-hidden="true" class="select-none py-1 text-xl font-bold leading-none text-fg/20 md:text-3xl">/</span>}
          <button type="button" data-filter={key} aria-pressed={key === "all"} class="relative z-10 whitespace-nowrap px-3 py-1 text-xl font-bold leading-none tracking-tight text-fg/35 transition-colors hover:text-fg md:text-3xl aria-pressed:text-fg group-data-[ready]:aria-pressed:text-white">
            {label}<sup class="ml-1 font-mono text-[0.6rem] font-normal md:text-sm">{count}</sup>
          </button>
          </Fragment>
        ))
      }
    </div>
  </div>

  <section id="work" class="mt-6 grid grid-cols-2 gap-x-3 gap-y-8 px-5 md:grid-cols-3 md:pr-14 lg:grid-cols-5">
    <h2 class="sr-only">Selected work</h2>
    {
      work.map(({ id, data }, i) => (
        <a href={`/work/${id}`} data-category={data.category} data-slug={id} data-title={data.title} data-client={data.client} data-meta={[data.role, data.year].filter(Boolean).join(" · ") || undefined} data-desc={data.description} data-file={data.videoFile} data-embed={data.videoUrl ? parseVideo(data.videoUrl).embed : undefined} class="group block">
          <div class="relative aspect-[9/16] overflow-hidden rounded-sm bg-surface">
            <img src={`/previews/${id}.webp`} alt="" width="450" height="800" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
            <video data-src={`/previews/${id}.mp4`} muted loop playsinline preload="none" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover"></video>
            {/* Play button on hover. Decorative: the whole card is the link. */}
            <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center bg-[radial-gradient(ellipse_at_center,rgb(0_0_0/0.25),rgb(0_0_0/0.75))] opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-white text-black shadow-lg">
                <svg class="ml-0.5 h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
              </span>
            </span>
          </div>
          <p class="mt-3 font-medium">
            <span class="font-mono text-sm font-normal text-muted">{String(i + 1).padStart(2, "0")}</span>{" "}
            {data.title}
          </p>
          {data.client && <p class="text-sm text-accent">{data.client}</p>}
        </a>
      ))
    }
  </section>

  {/* Video modal. The native dialog gives focus trapping and Esc for free; the backdrop is the blur. */}
  {/* Like Shorts: the video alone, with the title and a clipped description over its bottom-left. Tapping the caption sets data-details, which widens the dialog and shows the details panel. */}
  <dialog id="player" aria-label="Video player" class="group/dlg m-auto h-[92vh] max-h-none w-[94vw] max-w-none overflow-y-auto rounded-lg border-0 bg-surface p-0 text-fg shadow-2xl backdrop:bg-black/80 backdrop:backdrop-blur-xl md:flex md:w-[calc(92vh*9/16)] md:overflow-hidden md:data-[details]:w-[min(94vw,calc(92vh*9/16+34rem))]">
    <div id="player-slot" class="relative aspect-[9/16] w-full shrink-0 bg-black md:h-full md:w-auto"></div>
    <button type="button" id="player-cap" hidden aria-expanded="false" aria-controls="player-details" class="absolute inset-x-0 bottom-16 flex flex-col gap-1 px-4 pb-1 pt-8 text-left text-white [text-shadow:0_1px_3px_rgb(0_0_0/0.6)]">
      <span id="cap-title" class="line-clamp-1 font-bold"></span>
      <span id="cap-desc" class="line-clamp-2 text-sm text-white/85"></span>
    </button>
    <div id="player-details" class="hidden p-6 group-data-[details]/dlg:block md:flex-1 md:overflow-y-auto md:p-8 md:pr-16">
      <p id="player-client" class="text-sm text-accent"></p>
      <h2 id="player-title" class="text-2xl font-bold md:text-3xl"></h2>
      <p id="player-meta" class="mt-2 text-muted"></p>
      <p id="player-desc" class="mt-4 max-w-prose"></p>
    </div>
    <button type="button" id="player-close" aria-label="Close video" class="absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full bg-black/15 text-white/50 transition hover:bg-black/50 hover:text-whitemd:group-data-[details]/dlg:bg-transparent md:group-data-[details]/dlg:text-fg md:group-data-[details]/dlg:hover:bg-fg/10">
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
    </button>
  </dialog>

  {/* Ruler scrollbar. Ticks are decorative; the labels are real links, and click or drag on the ruler seeks. Desktop only. The strip is the only part that catches the mouse, and the labels appear when it is hovered. */}
  <nav id="ruler" aria-label="Page sections" class="group pointer-events-none fixed bottom-0 right-0 top-16 z-40 hidden w-40 touch-none md:block">
    <div aria-hidden="true" class="ruler-ticks pointer-events-auto absolute inset-y-0 right-0 w-12"></div>
    <span id="ruler-thumb" aria-hidden="true" class="absolute right-0 top-0 h-0.5 w-9 bg-[#7c6fe0]">
      <span class="absolute -left-1.5 -top-[5px] h-3 w-3 rounded-full border-2 border-white bg-[#3b5bdb]"></span>
    </span>
    {
      [["#", "Top"], ["#filters", "Work"], ["#contact", "Contact"]].map(([href, label]) => (
        <a href={href} class="pointer-events-none absolute right-10 rotate-180 [writing-mode:vertical-rl] font-mono text-base font-medium uppercase tracking-wider text-(--ruler)/70 opacity-0 transition-all focus-visible:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 group-hover:pointer-events-auto group-hover:text-xl group-hover:opacity-100 hover:underline">
          {label}
        </a>
      ))
    }
  </nav>

  <script>
    const ruler = document.getElementById("ruler")!;
    const thumb = document.getElementById("ruler-thumb")!;
    const labels = ruler.querySelectorAll<HTMLAnchorElement>("a");
    const PAD = 12;
    const max = () => document.documentElement.scrollHeight - innerHeight;
    const toY = (p: number) => PAD + p * (ruler.clientHeight - 2 * PAD);
    const moveThumb = () => (thumb.style.top = `${toY(Math.min(scrollY / max(), 1))}px`);
    // Labels sit where their section starts, as a share of the scrollable height.
    const place = () => {
      labels.forEach((a) => {
        const el = a.hash.length > 1 ? document.querySelector(a.hash) : null;
        const start = el ? el.getBoundingClientRect().top + scrollY : 0;
        const p = Math.min(start / max(), 1);
        a.style.top = `${toY(p)}px`;
        // Vertical text hangs below the point at the top of the page and above it at the bottom, so it never leaves the screen.
        a.style.translate = `0 -${p * 100}%`;
      });
      moveThumb();
    };
    const seek = (e: PointerEvent) =>
      scrollTo({ top: ((e.clientY - ruler.getBoundingClientRect().top - PAD) / (ruler.clientHeight - 2 * PAD)) * max(), behavior: "instant" });
    ruler.addEventListener("pointerdown", (e) => {
      if ((e.target as Element).closest("a")) return;
      ruler.setPointerCapture(e.pointerId);
      seek(e);
    });
    ruler.addEventListener("pointermove", (e) => ruler.hasPointerCapture(e.pointerId) && seek(e));
    addEventListener("scroll", moveThumb, { passive: true });
    // Page height changes when images load or a filter hides cards.
    new ResizeObserver(place).observe(document.body);
    place();
  </script>

  <script>
    // Chips show or hide cards by category. Hidden cards leave the screen, so their clips pause on their own.
    const bar = document.getElementById("filters")!;
    const pill = document.getElementById("filter-pill")!;
    const chipButtons = document.querySelectorAll<HTMLButtonElement>("#filters button");
    const movePill = () => {
      const active = bar.querySelector<HTMLElement>("[aria-pressed=true]")!;
      pill.style.left = `${active.offsetLeft}px`;
      pill.style.top = `${active.offsetTop}px`;
      pill.style.width = `${active.offsetWidth}px`;
      pill.style.height = `${active.offsetHeight}px`;
    };
    chipButtons.forEach((btn) =>
      btn.addEventListener("click", () => {
        chipButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        movePill();
        document.querySelectorAll<HTMLElement>("#work a").forEach((card) => {
          card.hidden = btn.dataset.filter !== "all" && card.dataset.category !== btn.dataset.filter;
        });
      }),
    );
    // Place the pill once the font has loaded (widths change), then keep it right on resize.
    document.fonts.ready.then(() => {
      movePill();
      bar.dataset.ready = "";
    });
    addEventListener("resize", movePill);
  </script>

  <script>
    // The player is built on click and emptied on close, so nothing loads or keeps playing in the background.
    import { addControls } from "../lib/player";
    const dlg = document.getElementById("player") as HTMLDialogElement;
    const slot = document.getElementById("player-slot")!;
    const cap = document.getElementById("player-cap") as HTMLButtonElement;
    cap.addEventListener("click", () => cap.setAttribute("aria-expanded", String(dlg.toggleAttribute("data-details"))));

    // Warm-up: while a card is hovered or touched, load its player in a hidden iframe so the real one starts faster.
    // One at a time, and never on data-saver or 2g. shortcut: this only warms the player page and its code; the video data itself can't be preloaded from another site.
    const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
    let warm: HTMLIFrameElement | undefined;
    const slowLink = conn?.saveData || /2g/.test(conn?.effectiveType ?? "");
    const warmUp = (card: HTMLElement) => {
      const { embed } = card.dataset;
      if (!embed || slowLink || dlg.open || warm?.src === embed) return;
      warm?.remove();
      warm = Object.assign(document.createElement("iframe"), { src: embed, hidden: true, tabIndex: -1 });
      warm.setAttribute("aria-hidden", "true");
      document.body.append(warm);
    };

    // Waterfall: the page, thumbnails and card clips come first. Once the page has loaded and the browser is idle,
    // warm the first few players one by one in grid order. shortcut: only the first WARM_FIRST, to stay clear of Drive's throttling; raise it if hover warm-up proves the gain.
    const WARM_FIRST = 6;
    addEventListener("load", async () => {
      if (slowLink) return;
      for (const card of [...document.querySelectorAll<HTMLAnchorElement>("#work a[data-embed]")].slice(0, WARM_FIRST)) {
        await new Promise((r) => ("requestIdleCallback" in window ? requestIdleCallback(r, { timeout: 3000 }) : setTimeout(r, 1500)));
        if (dlg.open) return;
        warmUp(card);
        // Next one starts when this player has loaded (or after 4 s, so a stuck one can't block the rest).
        await new Promise((r) => {
          warm?.addEventListener("load", r, { once: true });
          setTimeout(r, 4000);
        });
      }
    });

    document.querySelectorAll<HTMLAnchorElement>("#work a").forEach((card) => {
      card.addEventListener("pointerenter", () => warmUp(card));
      card.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button) return; // let "open in new tab" work
        e.preventDefault();
        const { slug, title, embed, file } = card.dataset;
        let player: HTMLElement;
        if (file) {
          // Self-hosted: the browser can buffer it, and the poster shows until the first frame.
          player = Object.assign(document.createElement("video"), { src: `/videos/${file}`, poster: `/previews/${slug}.webp`, autoplay: true, playsInline: true, preload: "auto" });
        } else if (embed) {
          // A click counts as user interaction, so the video can start with sound.
          player = Object.assign(document.createElement("iframe"), { src: `${embed}?autoplay=1&playsinline=1`, title, allowFullscreen: true });
          player.setAttribute("allow", "autoplay; fullscreen");
          // Players paint black before the first frame, so keep the still showing and fade the player in.
          // shortcut: a fixed delay after load, since a cross-origin player can't tell us when video starts. Raise it if black still flashes on slow connections.
          player.classList.add("opacity-0", "transition-opacity", "duration-500");
          player.addEventListener("load", () => setTimeout(() => player.classList.remove("opacity-0"), 900));
        } else {
          // shortcut: no full video linked yet, so the short preview loops here.
          player = Object.assign(document.createElement("video"), { src: `/previews/${slug}.mp4`, autoplay: true, muted: true, loop: true, playsInline: true });
        }
        player.className = "h-full w-full";
        // The card's still shows behind the player until the video paints over it.
        slot.style.background = `center / cover url(/previews/${slug}.webp) black`;
        slot.replaceChildren(player);
        if (file) addControls(player as HTMLVideoElement, slot);
        // An embedded player draws its own controls over the bottom, so its details open at once instead of a caption.
        const embedOnly = !!embed && !file;
        dlg.toggleAttribute("data-details", embedOnly);
        cap.setAttribute("aria-expanded", String(embedOnly));
        cap.hidden = embedOnly;
        // The caption is out of the document while closed, so look inside it rather than by id.
        cap.querySelector("#cap-title")!.textContent = title ?? "";
        cap.querySelector("#cap-desc")!.textContent = card.dataset.desc ?? "";
        if (!embedOnly) slot.append(cap);
        // Details only show what is confirmed in the project file; empty ones are hidden.
        for (const key of ["title", "client", "meta", "desc"]) {
          const el = document.getElementById(`player-${key}`)!;
          el.textContent = card.dataset[key] ?? "";
          el.hidden = !card.dataset[key];
        }
        // Freeze the hero reel and card clips behind the modal, and remember which ones to resume.
        playing = [...document.querySelectorAll("video")].filter((v) => !v.paused && !dlg.contains(v));
        playing.forEach((v) => v.pause());
        warm?.remove(); // the real player takes over
        warm = undefined;
        dlg.showModal();
      });
    });
    let playing: HTMLVideoElement[] = [];
    // Removing the player stops its sound at once; the "close" event covers Esc.
    const cleanup = () => {
      slot.replaceChildren();
      playing.forEach((v) => v.play().catch(() => {}));
      playing = [];
    };
    const closeModal = () => {
      dlg.close();
      cleanup();
    };
    document.getElementById("player-close")!.addEventListener("click", closeModal);
    dlg.addEventListener("click", (e) => e.target === dlg && closeModal()); // click on the blur
    dlg.addEventListener("close", () => dlg.open || cleanup()); // a late event must not wipe a player opened since
  </script>

  <script>
    // Clips play on their own, fetched only when a card nears the screen and paused when it leaves.
    // Reduced motion keeps the still posters.
    if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach(({ target, isIntersecting }) => {
            const video = target as HTMLVideoElement;
            if (isIntersecting) {
              video.src ||= video.dataset.src!;
              video.play().catch(() => {});
            } else video.pause();
          }),
        { rootMargin: "200px" },
      );
      document.querySelectorAll("#work video").forEach((v) => io.observe(v));
    }
  </script>
</Base>
