---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import { parseVideo } from "../lib/video";
import { CTA_HREF, CTA_TEXT, HOOK_1, HOOK_2, REEL, REEL_POSTER } from "../lib/site";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
---

<Base>
  {/* The poster is a real img so it also shows when the video is hidden (reduced motion) or still loading. */}
  <section class="relative aspect-[8/3] min-h-[420px] w-full overflow-hidden bg-neutral-900">
    <img src={REEL_POSTER} alt="" width="1920" height="720" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
    {REEL && <video src={REEL} poster={REEL_POSTER} autoplay muted loop playsinline preload="metadata" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover"></video>}
    {/* Dark layer keeps the footage from competing with the text. Heavier at the bottom where the text sits. */}
    <div class="absolute inset-0 bg-black/78 backdrop-blur-[2px] bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
    <div class="absolute inset-0 flex flex-col items-center justify-center px-5 text-center text-white">
      <h1 class="max-w-3xl text-balance text-[1.75rem] font-bold leading-tight md:text-[3.4rem]">
        <span class="block">
          {HOOK_1.before}{" "}<span class="bg-[#7c6fe0] px-2 [box-decoration-break:clone]">{HOOK_1.mark}</span>{HOOK_1.after}
        </span>
        <span class="mt-3 block md:mt-4">
          {HOOK_2.before}{" "}
          {/* Selection-box look: corner handles and a cursor. Decorative parts are aria-hidden. */}
          <span class="relative mx-1 inline-block bg-[#7c6fe0] px-2 md:px-3">
            {HOOK_2.mark}
            <span aria-hidden="true" class="absolute -left-2 -top-2 h-3.5 w-3.5 rounded-full border-2 border-white bg-[#3b5bdb] md:h-4 md:w-4"></span>
            <span aria-hidden="true" class="absolute -bottom-2 -right-2 h-3.5 w-3.5 rounded-full border-2 border-white bg-[#3b5bdb] md:h-4 md:w-4"></span>
            <svg aria-hidden="true" viewBox="0 0 24 24" class="absolute -bottom-7 -right-6 h-7 w-7 drop-shadow md:-bottom-9 md:-right-8 md:h-9 md:w-9">
              <path d="M4 2l16 9-7 2-3 7z" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linejoin="round" />
            </svg>
          </span>{" "}
          {HOOK_2.after}
        </span>
      </h1>
      <a href={CTA_HREF} class="group mt-10 inline-flex items-center gap-2 rounded-md bg-white px-5 py-3 font-bold text-black hover:bg-white/90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        {CTA_TEXT}
        {/* Lucide arrow-right, inlined like the theme icons. */}
        <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <section id="work" class="mt-12 grid gap-x-3 gap-y-8 px-5 sm:grid-cols-2 lg:grid-cols-4">
    <h2 class="sr-only">Selected work</h2>
    {
      work.map(({ id, data }, i) => {
        const thumb = data.thumbnail ?? (data.videoUrl ? parseVideo(data.videoUrl).thumbnail : undefined);
        return (
          <a href={`/work/${id}`} class="group block">
            <div class="aspect-video overflow-hidden rounded-sm bg-surface">
              {typeof thumb === "string" && (
                <img src={thumb} alt="" loading="lazy" class="h-full w-full object-cover transition-opacity group-hover:opacity-80" />
              )}
              {thumb && typeof thumb !== "string" && (
                <Image src={thumb} alt="" widths={[400, 800]} class="h-full w-full object-cover transition-opacity group-hover:opacity-80" />
              )}
            </div>
            <p class="mt-3 font-medium">
              <span class="font-mono text-sm font-normal text-muted">{String(i + 1).padStart(2, "0")}</span>{" "}
              {data.title}
            </p>
            <p class="text-sm text-accent">{data.client}</p>
          </a>
        );
      })
    }
  </section>
</Base>
